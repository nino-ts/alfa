{
  "name": "alfa",
  "version": "0.0.1",
  "type": "module",
  "description": "alfa framework",
  "license": "MIT",
  "keywords": [
    "bun",
    "framework",
    "typescript",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nino-ts/alfa.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "lint": "biome check ."
  },
  "bin": {
    "alfa": "./bin/alfa.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "imports": {
    "#alfa": "./src/index.ts",
    "#alfa/*": "./src/*/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http/index.ts",
    "./routing": "./src/routing/index.ts",
    "./database": "./src/database/index.ts",
    "./validation": "./src/validation/index.ts",
    "./session": "./src/session/index.ts",
    "./auth": "./src/auth/index.ts",
    "./container": "./src/container/index.ts",
    "./console": "./src/console/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "typescript": "^7.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.0"
  }
}
